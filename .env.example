# Database (Neon PostgreSQL with connection pooling on Vercel)
# DATABASE_URL: Pooled connection string (ends with -pooler.region.neon.tech with ?sslmode=require)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/dental_suite?sslmode=require"
# DIRECT_URL: Direct unpooled connection string (ends with .region.neon.tech with ?sslmode=require)
DIRECT_URL="postgresql://user:password@ep-sample.region.neon.tech/dental_suite?sslmode=require"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="https://your-domain.vercel.app"

# Public Base URL
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_DEFAULT_ORG_SLUG="senyum-sehat"
